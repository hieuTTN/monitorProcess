<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="monitorProcess.controllers.HashIntegrityView">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="15">

            <StackPanel>
                <TextBlock Text="KIỂM TRA TÍNH TOÀN VẸN FILE (HASH SHA-256)" FontSize="18" Foreground="#1A1A1A"/>
                <TextBlock Text="Quản lý CSDL hash đáng tin cậy (baseline) - dùng để phát hiện file thực thi bị thay đổi/giả mạo"
                           Foreground="Gray" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Background="#FFFFFF" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Để trống ô Hash để tự tính từ file trên máy, hoặc tự nhập hash (vd: lấy từ trang chủ nhà phát hành) để nhập/sửa thủ công."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>

                    <TextBox Name="TxtNewKnownPath" Watermark="Đường dẫn file, vd: /usr/sbin/sshd"/>
                    <TextBox Name="TxtNewKnownHash" Watermark="Hash SHA-256 (để trống để tự tính từ file)" FontFamily="Monospace"/>
                    <TextBox Name="TxtNewKnownDesc" Watermark="Mô tả (tùy chọn)"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Tự tính hash từ file" Click="OnAddKnownHashClick"
                                Background="#27ae60" Foreground="#1A1A1A"/>
                        <Button Content="Lưu hash thủ công" Click="OnSaveManualHashClick"
                                Background="#2980b9" Foreground="#1A1A1A"/>
                        <Button Content="Làm mới form" Click="OnClearKnownHashFormClick"
                                Background="#7f8c8d" Foreground="#1A1A1A"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="DANH SÁCH ĐANG THEO DÕI" FontWeight="Bold" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtCount" Foreground="Gray" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox Name="TxtSearch" Watermark="Tìm theo đường dẫn hoặc mô tả..." TextChanged="OnSearchChanged"/>

                    <ListBox Name="LstKnownHashes" Height="320" Background="#FAFAFC">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="4">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ExePath}" Foreground="#1A1A1A" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Sha256}" Foreground="#7f8c8d" FontSize="10" FontFamily="Monospace"/>
                                        <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Sửa" Tag="{Binding ExePath}"
                                            Click="OnEditKnownHashClick"
                                            Background="#f39c12" Foreground="#1A1A1A" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="Xóa" Tag="{Binding ExePath}"
                                            Click="OnRemoveKnownHashClick"
                                            Background="#c0392b" Foreground="#1A1A1A" Padding="8,4" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Name="TxtStatus" Foreground="Gray" TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>