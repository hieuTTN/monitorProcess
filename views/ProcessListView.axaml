<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="monitorProcess.controllers.ProcessListView">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="DANH SÁCH TIẾN TRÌNH" FontSize="18" Foreground="#1A1A1A"/>
            <TextBlock Text="Theo dõi tài nguyên, cổng mạng và trạng thái các tiến trình đang chạy" Foreground="Gray" Margin="0,5,0,0"/>
            <TextBlock Text="Để hiển thị đúng % CPU, hãy tắt tự động load sau 3s và ấn làm mới" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
            <TextBox Name="TxtSearch" Grid.Column="0"
                     Watermark="Tìm theo tên tiến trình, port hoặc PID..."
                     TextChanged="OnSearchChanged" />

             <ComboBox Name="CboSortBy" Grid.Column="1" Width="200" Margin="8,0,0,0"
                SelectedIndex="0" SelectionChanged="OnSortChanged">
                <ComboBoxItem Content="Mặc định (theo PID)"/>
                <ComboBoxItem Content="⚠ Tiến trình nguy hiểm trước"/>
                <ComboBoxItem Content="CPU cao nhất trước"/>
                <ComboBoxItem Content="RAM cao nhất trước"/>
                <ComboBoxItem Content="Tốc độ đọc đĩa cao nhất"/>
                <ComboBoxItem Content="Tốc độ ghi đĩa cao nhất"/>
                <ComboBoxItem Content="Tên (A → Z)"/>
            </ComboBox>

            <Button Name="BtnRefresh" Grid.Column="2" Content="Làm mới"
                    Click="OnRefreshClick" Margin="8,0,0,0" />

            <Button Name="BtnExportCsv" Grid.Column="3" Content="Xuất CSV"
                Click="OnExportCsvClick" Margin="8,0,0,0"
                Background="#16a085" Foreground="#1A1A1A" />

            <Button Name="BtnExportPdf" Grid.Column="4" Content="Xuất PDF"
                Click="OnExportPdfClick" Margin="8,0,0,0"
                Background="#8e44ad" Foreground="#1A1A1A" />
                
            <CheckBox Name="ChkAutoRefresh" Grid.Column="5"
                      Content="Tự động (3s)" IsChecked="True"
                      Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" Padding="10">
            <ListBox Name="LstProcesses" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" CornerRadius="4" Background="{Binding RowBackground}">
                            <StackPanel>
                                <TextBlock Foreground="#1A1A1A" FontWeight="Bold">
                                    <Run Text="{Binding Pid}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Name}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding UserName}"/>
                                    <Run Text=") - "/>
                                    <Run Text="{Binding State}"/>
                                </TextBlock>
                                <TextBlock Foreground="Gray" FontSize="12" Text="{Binding ExePath}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <TextBlock Foreground="#2ecc71" FontSize="12" Text="{Binding ResourceText}" />
                                    <TextBlock Foreground="#9b59b6" FontSize="12" Text="{Binding IoText}" />
                                </StackPanel>
                                
                                <TextBlock Foreground="#3498db" FontSize="12"
                                           Text="{Binding Ports}"
                                           IsVisible="{Binding !!Ports.Length}" />

                                <TextBlock Foreground="OrangeRed" FontSize="12"
                                           Text="{Binding AlertText}"
                                           IsVisible="{Binding IsSuspicious}" />

                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                    <Button Content="Kill" Tag="{Binding Pid}" Click="OnKillClick"
                                            Background="#c0392b" Foreground="#1A1A1A" Padding="10,4" FontSize="11"/>
                                    <Button Content="Dừng" Tag="{Binding Pid}" Click="OnStopClick"
                                            Background="#e67e22" Foreground="#1A1A1A" Padding="10,4" FontSize="11"/>
                                    <Button Content="Tiếp tục" Tag="{Binding Pid}" Click="OnContinueClick"
                                            Background="#27ae60" Foreground="#1A1A1A" Padding="10,4" FontSize="11"/>
                                    <Button Content="Khởi động lại" Tag="{Binding Pid}" Click="OnRestartClick"
                                            Background="#2980b9" Foreground="#1A1A1A" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Name="TxtStatus" Grid.Row="3" Margin="0,10,0,0"
                   Foreground="Gray" TextWrapping="Wrap" />
    </Grid>
</UserControl>