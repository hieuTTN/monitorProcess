<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="monitorProcess.controllers.WhitelistView">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="15">

            <StackPanel>
                <TextBlock Text="DANH SÁCH PHẦN MỀM ĐƯỢC PHÉP CHẠY (WHITELIST)" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Áp dụng mô hình 'default deny' - tiến trình KHÔNG nằm trong danh sách này sẽ bị cảnh báo/tự động chặn"
                           Foreground="Gray" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <Border Background="#3a2a1a" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <TextBlock Foreground="#f39c12" FontSize="12" TextWrapping="Wrap"
                               Text="⚠ Nếu danh sách để trống, hệ thống KHÔNG chặn gì (an toàn mặc định) - hãy thêm đầy đủ phần mềm hợp lệ trước khi tắt Log-only Mode."/>
                </Border>
            </StackPanel>

            <!-- Log-only Mode -->
            <Border Background="#1e1e2e" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <CheckBox Name="ChkLogOnlyMode" Content="Log-only Mode (chỉ ghi lại, KHÔNG chặn thật)"
                              Foreground="#f39c12" Checked="OnLogOnlyModeChanged" Unchecked="OnLogOnlyModeChanged"/>
                    <TextBlock Text="Bật khi mới setup whitelist - hệ thống vẫn chạy bình thường, mọi tiến trình bị coi là lạ sẽ được ghi vào danh sách bên dưới để bạn duyệt thêm 1 lần, thay vì bị chặn ngay."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Ứng viên whitelist thu thập từ Log-only Mode -->
            <Border Background="#1e1e2e" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="ỨNG VIÊN WHITELIST (từ Log-only Mode)" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Xóa hết" Click="OnClearSuggestionsClick"
                                Background="#7f8c8d" Foreground="White" Padding="8,4" FontSize="11"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Name="TxtSearchSuggestions" Watermark="Tìm theo tên hoặc đường dẫn..." TextChanged="OnSearchSuggestionsChanged"/>
                        <Button Grid.Column="1" Content="🔄 Tải lại" Click="OnReloadSuggestionsClick"
                                Background="#2980b9" Foreground="White" Margin="8,0,0,0"/>
                    </Grid>

                    <ListBox Name="LstSuggestions" Height="200" Background="#151521">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="4">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ExePath}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding SeenCount, StringFormat='Gặp {0} lần'}" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Thêm vào Whitelist" Tag="{Binding ExePath}"
                                            Click="OnAddSuggestionClick" Background="#27ae60" Foreground="White" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="Bỏ qua" Tag="{Binding ExePath}"
                                            Click="OnDismissSuggestionClick" Background="#c0392b" Foreground="White" Padding="8,4" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Thêm mới thủ công -->
            <Border Background="#1e1e2e" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="THÊM THỦ CÔNG" FontWeight="Bold" Foreground="White"/>
                    <TextBox Name="TxtNewProcessName" Watermark="Tên tiến trình, vd: sshd"/>
                    <TextBox Name="TxtNewHash" Watermark="Hash SHA-256 (tùy chọn) - để trống nếu chỉ cần khớp tên" FontFamily="Monospace"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Thêm vào Whitelist" Click="OnAddClick"
                                Background="#27ae60" Foreground="White"/>
                        <Button Content="Làm mới form" Click="OnClearFormClick"
                                Background="#7f8c8d" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Danh sách hiện tại -->
            <Border Background="#1e1e2e" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="DANH SÁCH HIỆN TẠI" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Name="TxtCount" Foreground="Gray" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBox Name="TxtSearch" Watermark="Tìm theo tên tiến trình..." TextChanged="OnSearchChanged"/>

                    <ListBox Name="LstWhitelist" Height="320" Background="#151521">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Margin="4">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ProcessName}" Foreground="White" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ExpectedSha256}" Foreground="#7f8c8d" FontSize="11" FontFamily="Monospace"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Xóa" Tag="{Binding ProcessName}"
                                            Click="OnRemoveClick"
                                            Background="#c0392b" Foreground="White" Padding="8,4" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Name="TxtStatus" Foreground="Gray" TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>