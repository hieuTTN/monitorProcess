<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="monitorProcess.controllers.DashboardView">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">

            <TextBlock Text="TỔNG QUAN HỆ THỐNG" FontSize="18" FontWeight="Bold" Foreground="White"/>

            <!-- Thông tin hệ thống -->
            <Border Background="#1e1e2e" CornerRadius="8" Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="40">
                    <StackPanel>
                        <TextBlock Text="HOSTNAME" Foreground="Gray" FontSize="11"/>
                        <TextBlock Name="TxtHostname" Text="-" Foreground="White" FontWeight="Bold" FontSize="15"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="PHIÊN BẢN UBUNTU" Foreground="Gray" FontSize="11"/>
                        <TextBlock Name="TxtOsVersion" Text="-" Foreground="White" FontWeight="Bold" FontSize="15"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="KERNEL" Foreground="Gray" FontSize="11"/>
                        <TextBlock Name="TxtKernel" Text="-" Foreground="White" FontWeight="Bold" FontSize="15"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="UPTIME" Foreground="Gray" FontSize="11"/>
                        <TextBlock Name="TxtUptime" Text="-" Foreground="White" FontWeight="Bold" FontSize="15"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tải hệ thống -->
            <Grid ColumnDefinitions="*,*,*,*">
                <!-- CPU -->
                <Border Grid.Column="0" Background="#1e1e2e" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CPU USAGE" Foreground="Gray" FontSize="11"/>
                        <TextBlock Name="TxtCpuPercent" Text="0%" Foreground="#2ecc71" FontSize="26" FontWeight="Bold"/>
                        <ProgressBar Name="BarCpu" Minimum="0" Maximum="100" Value="0" Height="6"/>
                        <StackPanel Name="SparkCpu" Orientation="Horizontal" Height="40" Spacing="2" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Grid.Column="1" Background="#1e1e2e" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="RAM USAGE" Foreground="Gray" FontSize="11"/>
                        <TextBlock Name="TxtRamPercent" Text="0%" Foreground="#3498db" FontSize="26" FontWeight="Bold"/>
                        <ProgressBar Name="BarRam" Minimum="0" Maximum="100" Value="0" Height="6"/>
                        <TextBlock Name="TxtRamDetail" Text="0 / 0 MB" Foreground="Gray" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Disk I/O -->
                <Border Grid.Column="2" Background="#1e1e2e" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="DISK I/O" Foreground="Gray" FontSize="11"/>
                        <TextBlock Name="TxtDiskRead" Text="Đọc: 0 B/s" Foreground="#9b59b6" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Name="TxtDiskWrite" Text="Ghi: 0 B/s" Foreground="#9b59b6" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Grid.Column="3" Background="#1e1e2e" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="NETWORK TRAFFIC" Foreground="Gray" FontSize="11"/>
                        <TextBlock Name="TxtNetRx" Text="Nhận: 0 B/s" Foreground="#e67e22" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Name="TxtNetTx" Text="Gửi: 0 B/s" Foreground="#e67e22" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>